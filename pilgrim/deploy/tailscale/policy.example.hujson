// Tailnet policy for the Pilgrim split (SPLIT_PLAN §6.4) + the VPC bastion
// (SCALABILITY.md Step 8). This mirrors the production policy as applied on
// 2026-11-05 minus the operator's own nodeAttrs; HuJSON allows comments and
// trailing commas.
//
// Operator checklist:
//   [ ] No default allow-all rule (e.g. {"src":["*"],"dst":["*"]}).
//   [ ] No other grant matches tag:radio-relay or pilgrim-origin.
//   [ ] The bastion joins tagged (tag:radio-relay); its auth key comes from
//       SSM, never from the repo.
//   [ ] No exit node anywhere. The ONE subnet route is the bastion's VPC CIDR.
//   [ ] HTTPS certificates and MagicDNS are enabled for the tailnet
//       (required for the gateway's :443 serve config until Step 9).
//   [ ] pilgrim-origin is a grant source ONLY toward pilgrim-vpc; the
//       gateway still initiates nothing toward edges.
{
  "tagOwners": {
    "tag:radio-relay": ["autogroup:admin"],
  },

  "hosts": {
    "pilgrim-origin": "100.114.40.70", // justins-mac-studio
    "pilgrim-vpc":    "172.31.0.0/16", // AWS VPC, routed via the bastion (tag:radio-relay)
  },

  "grants": [
    // Edge -> origin gateway, 443 only (retired at SCALABILITY.md Step 9).
    {"src": ["tag:radio-relay"], "dst": ["pilgrim-origin"], "ip": ["tcp:443"]},
    // Origin -> RDS Postgres + Valkey inside the VPC, through the bastion's
    // subnet route (SNAT on, so the VPC sees the bastion's private IP).
    // Only these two ports; the bastion's own tailnet address is not a dst.
    {"src": ["pilgrim-origin"], "dst": ["pilgrim-vpc"], "ip": ["tcp:5432", "tcp:6379"]},
    // No edge-to-edge grant. No SSH rules.
  ],

  // The bastion may advertise the VPC route without a console click.
  "autoApprovers": {
    "routes": {
      "172.31.0.0/16": ["tag:radio-relay"],
    },
  },
}
