{
  "_comment": "ECS Fargate task definition for the web tier (SCALABILITY.md Step 1). Placeholders in @@...@@ are filled by IaC (terraform-aws-pilgrim). Secrets are referenced, never inlined. The container port matches the ALB target group (modules/ec2/alb.tf: port 8080); the target group health path becomes /api/health at cutover (SCALABILITY.md §6). ARM64 is the operator's choice (Graviton; native build on the M5). Until the web tier exists (Step 5) the image runs today's single-host server, so this is a shape to build IaC against, not a deployable service.",
  "family": "pilgrim-web",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "runtimePlatform": {
    "operatingSystemFamily": "LINUX",
    "cpuArchitecture": "ARM64"
  },
  "executionRoleArn": "@@EXECUTION_ROLE_ARN@@",
  "taskRoleArn": "@@TASK_ROLE_ARN@@",
  "containerDefinitions": [
    {
      "name": "web",
      "image": "@@ECR_REPO_URL@@:@@IMAGE_TAG@@",
      "essential": true,
      "readonlyRootFilesystem": false,
      "user": "10001:10001",
      "portMappings": [
        { "containerPort": 8080, "protocol": "tcp", "appProtocol": "http" }
      ],
      "environment": [
        { "name": "REDIS_URL", "value": "@@REDIS_URL@@" },
        { "name": "DATABASE_URL", "value": "@@DATABASE_URL@@" },
        { "name": "DB_PASS_SECRET_ARN", "value": "@@DB_PASS_SECRET_ARN@@" },
        { "name": "PILGRIM_CONFIG_OVERLAY", "value": "/app/pilgrim/deploy/container/overlay.yaml" },
        { "name": "PILGRIM_ENV_FILE", "value": "" }
      ],
      "secrets": [
        { "name": "LITELLM_TOKEN", "valueFrom": "@@LITELLM_TOKEN_SECRET_ARN@@" },
        { "name": "BRAVE_SEARCH_KEY", "valueFrom": "@@BRAVE_SEARCH_KEY_SECRET_ARN@@" },
        { "name": "STRIPE_SECRET_KEY", "valueFrom": "@@STRIPE_SECRET_KEY_SECRET_ARN@@" },
        { "name": "STRIPE_PUBLISHABLE_KEY", "valueFrom": "@@STRIPE_PUBLISHABLE_KEY_SECRET_ARN@@" },
        { "name": "STRIPE_WEBHOOK_SECRET", "valueFrom": "@@STRIPE_WEBHOOK_SECRET_SECRET_ARN@@" },
        { "name": "PAID_OVERRIDE_TOKEN", "valueFrom": "@@PAID_OVERRIDE_TOKEN_SECRET_ARN@@" }
      ],
      "healthCheck": {
        "command": [
          "CMD",
          "python",
          "-c",
          "import sys, urllib.request; r = urllib.request.urlopen('http://127.0.0.1:8080/api/health', timeout=3); sys.exit(0 if r.status == 200 else 1)"
        ],
        "interval": 15,
        "timeout": 3,
        "retries": 3,
        "startPeriod": 20
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/pilgrim-web",
          "awslogs-region": "@@AWS_REGION@@",
          "awslogs-stream-prefix": "web"
        }
      },
      "stopTimeout": 30
    }
  ]
}
